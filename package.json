{
  "name": "xeno-anomaly-agents",
  "version": "1.0.0",
  "description": "Anomaly-detection agents. src/core is the common half every module extends; src/modules/<part> is the part-specific half. Journeys is the first module.",
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "husky install",
    "clean": "./node_modules/.bin/rimraf coverage build tmp",
    "build": "yarn clean && tsc -p tsconfig.release.json",
    "lint": "eslint ./src ./tests --ext .ts,.js",
    "lint:fix": "yarn lint --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "detect": "ts-node -r dotenv/config src/scripts/detect.ts",
    "tickets:plan": "ts-node -r dotenv/config src/scripts/ticketsPlan.ts",
    "skill:generate": "ts-node src/scripts/generateSkill.ts",
    "skill:check": "ts-node src/scripts/generateSkill.ts --check",
    "queries": "ts-node -r dotenv/config src/scripts/queries.ts",
    "plan": "ts-node -r dotenv/config src/scripts/plan.ts"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "yarn lint:fix"
    ]
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.27.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-sonarjs": "^1.0.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.9",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.3",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
